rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Lit le document /users/{uid} et retourne la donnée (ou null si absent)
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function getUserRole(uid) {
      return userDoc(uid).data.role;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function isStaff() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getUserRole(request.auth.uid) in ['admin', 'serveur', 'cuisine'];
    }

    function isAdmin() {
      return isAuthenticated()
        && userExists(request.auth.uid)
        && getUserRole(request.auth.uid) == 'admin';
    }

    // Tables: lecture publique, écriture admin
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: lecture publique, écriture admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: lecture publique, écriture admin
    // L'incrément de orderCount (validate commande) est fait par le serveur → isStaff()
    match /products/{productId} {
      allow read: if true;
      allow update: if isStaff();
      allow create, delete: if isAdmin();
    }

    // Orders: création libre (client anonyme), lecture/maj par staff
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Users: chaque utilisateur lit son propre doc, admin gère tout
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
